.git/

# Local secrets and machine-specific config
.env
.env.*
!.env.example
.mcp.local.json
*.pem
*.key
*.crt

# Local caches and virtualenvs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Local runtime output
*.log
*.out
*.err
artifacts/
